# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# Leave empty to run in clearly-labelled simulation mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox *personal* accounts (developer.paypal.com -> Sandbox -> Accounts) that receive payouts
PAYPAL_KARIGAR_EMAIL=
PAYPAL_SAATHI_EMAIL=
# Sandbox buyer account used on invoices until the real payer email is known
PAYPAL_CUSTOMER_EMAIL=
# Optional: a sandbox *buyer* login shown under the PayPal button so testers can pay with test money
# (Testing Tools > Sandbox Accounts > a Personal account). Test money only; never real credentials.
PAYPAL_DEMO_BUYER_EMAIL=
PAYPAL_DEMO_BUYER_PASSWORD=
# Optional: webhook id from your sandbox app's Webhooks section (enables signature verification).
# Subscribe the webhook to payment events and, for Sudhaar Care, BILLING.SUBSCRIPTION.* and PAYMENT.SALE.COMPLETED.
PAYPAL_WEBHOOK_ID=
# Optional: this site's public address, used as the PayPal return link for Sudhaar Care
# (e.g. https://your-sudhaar.onrender.com). Without it the address is taken from the request.
# APP_URL=

# --- Razorpay, for payments inside India: UPI (GPay, PhonePe, Paytm), cards, netbanking ---
# Test mode only: dashboard.razorpay.com -> Test mode -> API keys. Key id starts with rzp_test_.
# Leave empty to run the UPI / card checkout in clearly-labelled simulation mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret (payment.authorized, payment.captured, refund.processed, transfer.processed)
RAZORPAY_WEBHOOK_SECRET=
# Optional: Route linked accounts (acc_...) that receive the karigar's and the Saathi's share
RAZORPAY_KARIGAR_ACCOUNT=
RAZORPAY_SAATHI_ACCOUNT=
# Optional: minutes Razorpay keeps an uncaptured (held) payment, default 7200 (5 days)
# RAZORPAY_HOLD_MINUTES=7200

# --- AI (Google Gemini) ---
# Free key: aistudio.google.com -> Get API key. Leave empty to use the simulated estimator.
# The Repair Agent (Talk tab) requires a key.
GEMINI_API_KEY=
# Optional: a specific Gemini model; defaults to Google's current Flash model.
# AI_MODEL=gemini-flash-latest
# Used automatically when the main model is overloaded or times out.
# AI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Phone line on Bolna (docs/BOLNA.md) ---
# Secret Bolna sends to Sudhaar's /api/voice/* endpoints. Leave empty to keep the phone line off.
VOICE_API_TOKEN=
# Optional: the number customers dial (shown on the website)
VOICE_PHONE_NUMBER=
# Optional: "Ask Sudhaar to call me" (Bolna outbound call API)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# BOLNA_FROM_NUMBER=

# --- SMS (pay links, OTPs, price changes, claim updates). Without these, texts are only logged. ---
# SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that sends the texts (or use a Messaging Service SID instead)
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# --- Keep data across restarts (Render's free plan wipes the disk). Free Upstash Redis: upstash.com ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: name prefix for this site's data in Upstash (default "sudhaar-iim"), so several sites can share one database
# UPSTASH_KEY_PREFIX=sudhaar-iim

# --- Conductor timings (optional, minutes): payment reminders and the pickup reminder ---
# REMINDER_FIRST_MIN=120
# REMINDER_SECOND_MIN=1200
# PICKUP_REMINDER_MIN=60

# --- Logins ---
# Secret that signs login cookies (any long random string). If empty, one is generated
# and saved in DATA_DIR/.session-secret.
SESSION_SECRET=

# --- Demo ---
# DEMO_CENTER_LAT=12.9716
# DEMO_CENTER_LNG=77.5946
# DATA_DIR=./data

# Safety switches for any deployment holding real data (judging sandbox leaves them on).
# DEMO_ADMIN=off
# ALLOW_RESET=off
